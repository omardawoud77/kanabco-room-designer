# Copy to .env.local for local development. Never commit real values.
AI_FEATURE_ENABLED=false
ALLOWED_ORIGIN=https://custom.kanabco.net
AI_TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
AI_EDGE_SHARED_SECRET=
SESSION_SIGNING_KEY=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=custom.kanabco.net
# Required when the AI feature is enabled in production. Use the approved public policy URL.
AI_PHOTO_PRIVACY_URL=
# Development-only loopback test mode with Cloudflare's public dummy keys; never enable in production.
KANABCO_LOCAL_TURNSTILE_TEST=false

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
OPENAI_IMAGE_TIMEOUT_MS=150000
CLOUDFLARE_AI_GATEWAY_URL=
CF_AIG_TOKEN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

AI_MAX_BODY_BYTES=4000000
AI_MAX_IMAGE_BYTES=3500000
AI_MAX_IMAGE_PIXELS=12000000
AI_REQ_PER_MIN_PER_IP=2
AI_REQ_PER_DAY_PER_IP=10
AI_REQ_PER_DAY_PER_SESSION=2
AI_REQ_PER_DAY_GLOBAL=100
AI_MAX_INFLIGHT_PER_IP=1
AI_MAX_INFLIGHT_PER_SESSION=1
AI_MAX_INFLIGHT_GLOBAL=2
AI_IMAGE_RESERVED_USD=1.00
AI_DAILY_SESSION_USD_CAP=2.00
AI_DAILY_GLOBAL_USD_CAP=10.00
ALERT_SPEND_USD_PER_10MIN=2.00
LOG_PROMPTS=false
